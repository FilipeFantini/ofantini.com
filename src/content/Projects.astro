---
import ArticleList from '../components/ArticleList.astro';
import { loadLagom } from '../lib/lagom';
const { project, tracks } = await loadLagom();
---
<section class="intro"><p class="eyebrow">Independent work</p><h1>Projects</h1><div class="intro-bottom"><p>Lagom is the first project here, and more will follow. Every article is also listed on the <a href="/articles/">Articles page</a>.</p></div></section>
<section class="listing project-card">
  <h2><a href="/projects/lagom/">{project.data.title}</a></h2>
  <p>{project.data.summary}</p>
  {tracks.map(track => <div class="track"><h3>{track.articles.length ? <a href={track.href}>{track.name}</a> : track.name}</h3><ArticleList articles={track.articles} /></div>)}
</section>
