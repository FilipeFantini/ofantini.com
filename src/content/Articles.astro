---
import ArticleList from '../components/ArticleList.astro';
import { loadLagom } from '../lib/lagom';
import { loadPractices } from '../lib/practices';
const { project, groups, subprojects } = await loadLagom();
const practices = await loadPractices();
const parts = [
  { name: 'Platform', sections: groups },
  { name: 'Sources', sections: subprojects },
];
---
<section class="intro"><p class="eyebrow">Articles from the work</p><h1>Articles</h1><div class="intro-bottom"><p>Every article, grouped by project. <a href="/projects/lagom/">Lagom</a>, an open-source batch data platform, lists its shared platform first, then each data source.</p></div></section>
<section class="listing">
  <h2>{project.data.title}</h2>
  {parts.map(part => <>
    <h3 class="part">{part.name}</h3>
    {part.sections.filter(section => section.articles.length > 0).map(section => <div class="track"><h4><a href={section.href}>{section.name}</a></h4><ArticleList articles={section.articles} summaries /></div>)}
  </>)}
</section>
{practices.filter(practice => practice.articles.length > 0).map(practice => <section class="listing">
  <h2><a href={practice.href}>{practice.data.title}</a></h2>
  <ArticleList articles={practice.articles} summaries />
</section>)}
