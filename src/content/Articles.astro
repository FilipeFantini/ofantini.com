---
import ArticleList from '../components/ArticleList.astro';
import { loadLagom } from '../lib/lagom';
const { project, tracks } = await loadLagom();
---
<section class="intro"><p class="eyebrow">Articles from the work</p><h1>Articles</h1><div class="intro-bottom"><p>These articles follow the decisions and work behind <a href="/projects/lagom/">Lagom</a>, an open-source data platform.</p></div></section>
<section class="listing">
  <h2>{project.data.title}</h2>
  {tracks.filter(track => track.articles.length > 0).map(track => <div class="track"><h3><a href={track.href}>{track.name}</a></h3><ArticleList articles={track.articles} summaries /></div>)}
</section>
