---
import { render } from 'astro:content';
import Article from '../../../../../layouts/Article.astro';
import { loadLagom } from '../../../../../lib/lagom';

export async function getStaticPaths() {
  const { tracks } = await loadLagom();
  return tracks.flatMap(track => track.articles.map(article => ({ params: { track: track.id, slug: article.slug }, props: { article } })));
}

const { article } = Astro.props;
const { Content } = await render(article.entry);
---
<Article article={article}><Content /></Article>
