---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Content from '../../../../content/Track.astro';
import { loadLagom } from '../../../../lib/lagom';

// A track without articles has no page; the hub shows it as "In works".
export async function getStaticPaths() {
  const { tracks } = await loadLagom();
  return tracks.filter(track => track.articles.length > 0).map(track => ({ params: { track: track.id }, props: { track } }));
}

const { track } = Astro.props;
---
<BaseLayout title={track.name} windowTitle={`projects / lagom / ${track.id}`} up="/projects/lagom/"><Content track={track} /></BaseLayout>
