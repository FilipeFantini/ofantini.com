---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/site.css';
import '../styles/desk.css';
import Window from '../components/Window.astro';
interface Props { title: string; windowTitle: string; up?: string; kind?: string }
const { title, windowTitle, up, kind } = Astro.props;
const url = Astro.url.pathname;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} | ofantini.com</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head><body>
  <header class="site-header"><a href="/">ofantini<span class="dot">.</span>com</a><span>All things data and more</span></header>
  <main class="desk">
    <nav class="icons" aria-label="Explore">
      <a href="/about/"><b aria-hidden="true" data-icon="≡"></b><span>me.txt</span></a>
      <a href="/projects/"><b aria-hidden="true" data-icon="▰"></b><span>projects</span></a>
      <a href="/articles/"><b aria-hidden="true" data-icon="↗"></b><span>articles</span></a>
      <a href="https://github.com/FilipeFantini"><b aria-hidden="true" data-icon="›_"></b><span>github</span></a>
    </nav>
    <div class="wins"><Window url={url} title={windowTitle} up={up} kind={kind}><slot /></Window></div>
  </main>
  <nav class="task" aria-label="Open windows"><a href={url} aria-current="page">{windowTitle}</a></nav>
  <script>import '../scripts/desk.ts';</script>
</body></html>
