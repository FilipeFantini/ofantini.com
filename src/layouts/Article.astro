---
import BaseLayout from './BaseLayout.astro';
import ArticleDates from '../components/ArticleDates.astro';
import { loadLagom, type SectionArticle } from '../lib/lagom';
interface Props { article: SectionArticle }
const { article: { entry } } = Astro.props;
const { sections } = await loadLagom();
const sectionIndex = sections.findIndex(section => section.id === (entry.data.group ?? entry.data.subproject));
const section = sections[sectionIndex];
const position = section.articles.findIndex(item => item.entry.id === entry.id);
const previous = section.articles[position - 1];
const next = section.articles[position + 1];
// A section without articles has no page, so the next section link skips it.
const nextSection = sections.slice(sectionIndex + 1).find(item => item.articles.length > 0);
const number = String(entry.data.order).padStart(2, '0');
const commit = entry.data.lagom_commit;
const part = entry.data.group ? 'Platform' : 'Sources';
const eyebrow = { pipeline: 'Pipeline', report: 'Report' }[entry.data.kind ?? ''] ?? 'A decision in context';
---
<BaseLayout title={entry.data.title} windowTitle={`Lagom / ${section.name} / ${number}`} up={section.href} kind="article-window">
  <article class="article">
    <nav class="article-trail" aria-label="Article path"><a href="/projects/lagom/">Lagom</a> › {part} › <a href={section.href}>{section.name}</a> › {entry.data.title}</nav>
    <div class="article-label">LAGOM / {section.name.toUpperCase()} <span>FIELD NOTES</span></div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{entry.data.title}</h1>
    <p class="article-pin">A dated account, pinned to Lagom commit <a href={`https://github.com/FilipeFantini/lagom/tree/${commit}`}>{commit.slice(0, 7)}</a></p>
    <ArticleDates entry={entry} />
    <div class="article-content"><slot /></div>
    <nav class="article-links" aria-label="Article navigation">
      <a href="/projects/lagom/">Back to Lagom</a>
      {previous && <a href={previous.href} rel="prev">← Previous: {previous.entry.data.title}</a>}
      {next && <a href={next.href} rel="next">Next: {next.entry.data.title} →</a>}
      {!next && nextSection && <a href={nextSection.href}>Next section: {nextSection.name} →</a>}
    </nav>
  </article>
</BaseLayout>
