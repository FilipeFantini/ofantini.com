---
import BaseLayout from './BaseLayout.astro';
import { loadLagom, type TrackArticle } from '../lib/lagom';
interface Props { article: TrackArticle }
const { article: { entry } } = Astro.props;
const { tracks } = await loadLagom();
const trackIndex = tracks.findIndex(track => track.id === entry.data.track);
const track = tracks[trackIndex];
const position = track.articles.findIndex(item => item.entry.id === entry.id);
const previous = track.articles[position - 1];
const next = track.articles[position + 1];
// A track without articles has no page, so the next track link skips it.
const nextTrack = tracks.slice(trackIndex + 1).find(item => item.articles.length > 0);
const number = String(entry.data.order).padStart(2, '0');
const commit = entry.data.lagom_commit;
---
<BaseLayout title={entry.data.title} windowTitle={`Lagom / ${track.name} / ${number}`} up={track.href} kind="article-window">
  <article class="article">
    <nav class="article-trail" aria-label="Article path"><a href="/projects/lagom/">Lagom</a> › <a href={track.href}>{track.name}</a> › {entry.data.title}</nav>
    <div class="article-label">LAGOM / {track.name.toUpperCase()} <span>FIELD NOTES</span></div>
    <p class="eyebrow">A decision in context</p>
    <h1>{entry.data.title}</h1>
    <p class="article-pin">A dated account, pinned to Lagom commit <a href={`https://github.com/FilipeFantini/lagom/tree/${commit}`}>{commit.slice(0, 7)}</a></p>
    <div class="article-content"><slot /></div>
    <nav class="article-links" aria-label="Article navigation">
      <a href="/projects/lagom/">Back to Lagom</a>
      {previous && <a href={previous.href} rel="prev">← Previous: {previous.entry.data.title}</a>}
      {next && <a href={next.href} rel="next">Next: {next.entry.data.title} →</a>}
      {!next && nextTrack && <a href={nextTrack.href}>Next track: {nextTrack.name} →</a>}
    </nav>
  </article>
</BaseLayout>
