---
import type { SectionArticle } from '../lib/lagom';
import { day, lastChange } from '../lib/dates';
interface Props { articles: SectionArticle[]; summaries?: boolean }
const { articles, summaries = false } = Astro.props;
---
{articles.length === 0
  ? <p class="in-works">In works</p>
  : <ul class="articles">{articles.map(({ entry, href }) => <li><span class="num">{String(entry.data.order).padStart(2, '0')}</span><a href={href}>{entry.data.title}</a> <span class="date">{entry.data.updated ? 'Updated' : 'Published'} <time datetime={day(lastChange(entry))}>{day(lastChange(entry))}</time></span>{summaries && <p>{entry.data.summary}</p>}</li>)}</ul>}
