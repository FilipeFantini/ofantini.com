---
// The stack tags: a row of technologies, each named in text, used wherever a
// project or a data subproject presents its stack. A stack is a list of ids
// from src/data/technologies.json, the one registry of names, logos and the
// logos' sources and licences. A logo is inlined beside its name: it takes the
// text colour, needs no request, and is hidden from screen readers, which read
// the name.
import technologies from '../data/technologies.json';
import { iconParts } from '../lib/technology-icons.mjs';
interface Props { stack: string[]; label: string }
const { stack, label } = Astro.props;
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const known: Record<string, { name: string; icon?: string }> = technologies;
const items = stack.map(id => {
  const technology = known[id];
  if (!technology) throw new Error(`Unknown technology ${id}`);
  if (!technology.icon) return { name: technology.name };
  const file = icons[`../icons/${technology.icon}.svg`];
  if (!file) throw new Error(`Missing icon src/icons/${technology.icon}.svg for ${id}`);
  const { viewBox, body } = iconParts(file, technology.icon);
  return {
    name: technology.name,
    svg: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="${viewBox}" xmlns="http://www.w3.org/2000/svg">${body}</svg>`,
  };
});
---
<ul class="stack" aria-label={label}>{items.map(item => <li>{item.svg && <Fragment set:html={item.svg} />}<span>{item.name}</span></li>)}</ul>
